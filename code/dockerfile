FROM python:3.12-slim

ENV PYTHONDONTWRITEBYCODE=1 \

PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recomends curl && rm -rf /var/lib/apt/lists/*

COPY requirement.txt .

RUN pip install --no-cache-dir --pgrade pip&& pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8000

CMD ["gunicorn", "--bind", "0.0.0.0.8000", "--workers", "2", "maiin:app"]