# Local app auth
API_TOKEN=local-dev-token

# Docker MySQL container settings
MYSQL_DATABASE=interview_db
MYSQL_USER=interview_user
MYSQL_PASSWORD=interview_pass
MYSQL_ROOT_PASSWORD=interview_root_pass

# Default application DB connection values
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=interview_db
DB_USER=interview_user
DB_PASSWORD=interview_pass
